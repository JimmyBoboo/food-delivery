# Kopier denne filen til .env.local og fyll inn verdiene fra Supabase-prosjektet.
# Verdiene finnes under Project Settings -> API og Project Settings -> Database.

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"

# Project Settings -> API -> anon/public key (eller ny publishable-nokkel sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Project Settings -> API -> service_role key (eller sb_secret_...). Kun server-side, aldri i frontend.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Project Settings -> Database -> Connection string -> Transaction pooler (port 6543).
# Brukes av applikasjonen i drift.
#
# To fallgruver i strengene under:
#   1. Passord med tegn som @ : / ? # [ ] ma prosentkodes, ellers klarer ikke
#      driveren a se hvor passordet slutter og verten begynner.
#   2. uselibpqcompat=true ma vaere med. Fra node-postgres 8.16 betyr
#      sslmode=require full sertifikatvalidering, og da avvises Supabase sitt
#      selvsignerte sertifikat med "self-signed certificate in certificate chain".
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSORD@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require&uselibpqcompat=true"

# Project Settings -> Database -> Connection string -> Session pooler (port 5432).
# Brukes av Prisma Migrate og seed.
#
# Bruk session pooler, ikke "Direct connection". Den direkte verten
# db.<ref>.supabase.co svarer bare pa IPv6, som de fleste hjemmenett mangler.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:PASSORD@aws-0-eu-north-1.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"

# Offentlig URL til appen, brukes i betalingsredirect og QR-lenker.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Delt hemmelighet som den simulerte betalingsleverandoren signerer webhooks med.
PAYMENT_WEBHOOK_SECRET="bytt-meg-til-en-tilfeldig-streng"

# Passord som seed-scriptet setter pa de tre ansattbrukerne.
SEED_STAFF_PASSWORD="Golf2026!"
